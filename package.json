{
  "name": "multi-read",
  "version": "0.1.0",
  "private": true,
  "description": "Gloss: static adaptive French reader on a Cloudflare Worker with D1-synced learner state",
  "scripts": {
    "dev": "wrangler dev --port 8789 --var DEV_USER_EMAIL:dev@localhost",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "devDependencies": {
    "wrangler": "4.136.3"
  }
}
